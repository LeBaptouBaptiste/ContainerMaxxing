# Configuration du compose (aucun secret : les secrets sont dans secrets/).
# Copier en app.env et adapter, puis : podman-compose --env-file app.env up -d --build
# Commentaires sur leur propre ligne : --env-file ne retire pas les commentaires en fin de ligne.

# Image construite par le compose (ou image GHCR publiée par la CI)
APP_IMAGE=localhost/mon-app:latest
# Interface où l'app publie son port : jamais 0.0.0.0.
# 127.0.0.1 derrière un reverse proxy local, l'IP privée de la machine sinon.
APP_BIND=127.0.0.1
APP_PORT=8080
LOG_LEVEL=info
