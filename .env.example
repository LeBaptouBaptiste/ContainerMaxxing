# Copier en .env (non commité) et adapter.
# Commentaires sur leur propre ligne : --env-file ne retire pas les commentaires en fin de ligne.

# Serveur
LISTEN_ADDR=:8080
# local | phobos | azure : affiché dans le bandeau
APP_ENV=local
# mock pour l'instant ; les sources réelles viendront ensuite
DATA_SOURCE=mock
# Vide = défaut : 2s en mock, 5s sinon (borné entre 2s et 60s)
POLL_INTERVAL=
# debug | info | warn | error
LOG_LEVEL=info

# Jeton d'ingestion (POST /api/deployments depuis la CI), 32 caractères minimum.
# Générer avec : openssl rand -hex 32
# Préférer INGEST_TOKEN_FILE=/run/secrets/ingest_token en conteneur.
INGEST_TOKEN=

# Informations publiques affichées dans les panneaux (pas des secrets)
GITHUB_REPOSITORY=LeBaptouBaptiste/ContainerMaxxing
PHOBOS_URL=https://containermaxxing.voyager3.fr
AZURE_URL=https://cmx.voyager3.fr
ACR_NAME=containermaxxing
CAAS_APP=containermaxxing
