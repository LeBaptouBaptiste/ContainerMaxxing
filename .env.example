# Copier en .env (non commité) et adapter.
# Commentaires sur leur propre ligne : --env-file ne retire pas les commentaires en fin de ligne.

# Serveur
LISTEN_ADDR=:8080
# local | phobos | azure : affiché dans le bandeau
APP_ENV=local
# mock (simulation + mode démo) | live (étapes GitHub et Actions depuis l'API GitHub)
DATA_SOURCE=mock
# Vide = défaut : 2s en mock, 10s en live (borné entre 2s et 60s)
POLL_INTERVAL=
# debug | info | warn | error
LOG_LEVEL=info

# Base PostgreSQL de l'historique (vide = mémoire, accepté seulement avec APP_ENV=local).
# Contient le mot de passe : préférer DATABASE_URL_FILE=/run/secrets/database_url en conteneur.
#   compose (réseau interne) : postgres://cmx:<mot de passe>@postgres:5432/containermaxxing?sslmode=disable
#   Azure Flexible Server    : postgres://cmx:<mot de passe>@<serveur>.postgres.database.azure.com:5432/containermaxxing?sslmode=verify-full
DATABASE_URL=

# Cache Redis partagé (vide = cache en mémoire du processus). L'app continue si Redis tombe.
# Peut contenir le mot de passe : préférer REDIS_URL_FILE=/run/secrets/redis_url en conteneur.
#   compose (réseau interne)  : redis://:<mot de passe>@redis:6379/0
#   Azure Cache for Redis     : rediss://:<clé>@<nom>.redis.cache.windows.net:6380/0
REDIS_URL=

# Jeton d'ingestion (POST /api/deployments depuis la CI), 32 caractères minimum.
# Générer avec : openssl rand -hex 32
# Préférer INGEST_TOKEN_FILE=/run/secrets/ingest_token en conteneur.
INGEST_TOKEN=

# Source live : jeton GitHub en LECTURE SEULE (fine-grained, limité à ce dépôt :
# Actions: Read, Contents: Read, Metadata: Read). Quota 5 000 req/h au lieu de 60/h.
# Obligatoire en live hors APP_ENV=local. Préférer GITHUB_TOKEN_FILE=/run/secrets/github_token.
GITHUB_TOKEN=
# Workflow de CI suivi et branche principale
GITHUB_WORKFLOW=ci.yml
GITHUB_BRANCH=main

# Informations publiques affichées dans les panneaux (pas des secrets)
GITHUB_REPOSITORY=LeBaptouBaptiste/ContainerMaxxing
PHOBOS_URL=https://containers2v-statique.voyager3.fr
AZURE_URL=https://containers2v.voyager3.fr
# Image GHCR sans tag, en minuscules (vide = ghcr.io/<GITHUB_REPOSITORY>)
GHCR_IMAGE=ghcr.io/lebaptoubaptiste/containermaxxing
CAAS_APP=containers2v

# Contrôles de démo (scénarios, pause, pas à pas) : uniquement avec DATA_SOURCE=mock.
# Sans jeton en APP_ENV=local ; ailleurs, désactivés sauf si DEMO_TOKEN est défini (32 caractères min.).
# Préférer DEMO_TOKEN_FILE=/run/secrets/demo_token en conteneur.
DEMO_TOKEN=
