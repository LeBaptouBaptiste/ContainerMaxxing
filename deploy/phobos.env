# Configuration du compose sur phobos (aucun secret ici : ils sont dans secrets/).
#
#   podman-compose --env-file deploy/phobos.env up -d --build
#
# Toutes les variables sont explicites : podman-compose n'applique pas toujours
# les valeurs par défaut ${VAR:-…} du compose.
#
# Commentaires sur leur propre ligne : les fichiers d'environnement ne retirent
# pas les commentaires en fin de ligne.

# Interface et port où l'app est publiée, cible du proxy host NPM de beacon.
# Adresse privée : jamais 0.0.0.0.
APP_BIND=172.22.0.1
APP_PORT=11262

# Environnement affiché dans le bandeau de l'app.
APP_ENV=phobos

# Source des données (mock : simulation et mode démo) et niveau de journalisation.
DATA_SOURCE=mock
LOG_LEVEL=info

# Informations publiques affichées dans les panneaux.
GITHUB_REPOSITORY=LeBaptouBaptiste/ContainerMaxxing
PHOBOS_URL=https://containers2v-statique.voyager3.fr/
AZURE_URL=https://containers2v.voyager3.fr/
GHCR_IMAGE=ghcr.io/lebaptoubaptiste/containermaxxing

# Nom de la Container App Azure, affiché dans l'étape « Container Apps ».
CAAS_APP=containers2v

# Image construite par le compose.
APP_IMAGE=localhost/containermaxxing:latest
