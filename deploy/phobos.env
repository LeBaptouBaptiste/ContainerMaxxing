# Configuration du compose sur phobos (aucun secret ici : ils sont dans secrets/).
#
#   podman-compose --env-file deploy/phobos.env up -d --build
#
# Commentaires sur leur propre ligne : les fichiers d'environnement ne retirent
# pas les commentaires en fin de ligne.

# Interface et port où l'app est publiée, cible du proxy host NPM de beacon.
# Adresse privée : jamais 0.0.0.0.
APP_BIND=172.22.0.1
APP_PORT=11262

# Environnement affiché dans le bandeau de l'app.
APP_ENV=phobos

# Nom de la Container App Azure, affiché dans l'étape « Container Apps ».
CAAS_APP=containers2v
